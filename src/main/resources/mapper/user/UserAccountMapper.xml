<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 用户账号持久层。 -->
<mapper namespace="com.malls.user.mapper.UserAccountMapper">


<!--登出未完成-->


    <!--
      该 Mapper 目前所有查询/写入都走 BaseMapper 内置方法（selectById / selectPage /
      insert / updateById ...），没有自定义 SQL，所以这里只有 namespace。

      之后要加自定义 SQL 就写在本文件里，接口中不再使用 @Select / @Update 注解：
      注解里的 SQL 无法复用 <sql> 片段、无法做 <if> 动态拼接，也躲不过编译期检查。
    -->

    <!--
      登出 / 改密：令牌版本号自增，旧令牌立即失效（JwtAuthFilter 会比对 tv 与库里的值）。

      注意 #{id} 的 # 不能少：写成 {id} 会生成 "id ={id}" 这种非法 SQL，
      被 BlockAttackInnerInterceptor 解析时直接抛 ParseException（登出 500 的元凶）。
    -->
    <update id="bumpTokenVersion">
        update user_account
        set token_version = token_version + 1
        where id = #{id}
          and deleted = 0
    </update>
</mapper>
